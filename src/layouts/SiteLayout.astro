---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/dm-sans';
import '../styles/site.css';
import { home, locales, routes, type Locale } from '../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = home[locale];
const canonical = new URL(routes[locale], Astro.site);
---

<!doctype html>
<html lang={copy.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.description} />
    <meta name="theme-color" content="#f7f5ee" />
    <title>{copy.title}</title>
    <link rel="icon" type="image/png" href="/imagenes/icono-aura.png" />
    <link rel="canonical" href={canonical} />
    {locales.map((language) => (
      <link rel="alternate" hreflang={home[language].language} href={new URL(routes[language], Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(routes.es, Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{copy.skip}</a>
    <slot />
  </body>
</html>
