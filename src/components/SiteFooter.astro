---
import { site, type Locale } from '../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = {
  es: {
    heading: 'Datos institucionales',
    official: 'Este es el sitio web oficial de Fundación AURA.',
    taxId: 'CUIT',
    registration: 'Resolución de inscripción',
    location: 'Localidad',
    contact: 'Correo electrónico',
  },
  en: {
    heading: 'Organization details',
    official: 'This is the official website of Fundación AURA.',
    taxId: 'Tax ID (CUIT)',
    registration: 'Registration resolution',
    location: 'Location',
    contact: 'Email',
  },
}[locale];
---

<footer class="site-footer" id="contacto">
  <div class="shell footer-inner">
    <div>
      <img src="/imagenes/icono-aura.png" width="56" height="56" alt="" loading="lazy" />
      <h2>{site.name}</h2>
      <p>{copy.official}</p>
      <p>{site.domain}</p>
    </div>
    <div>
      <h3>{copy.heading}</h3>
      <dl>
        <div><dt>{copy.taxId}</dt><dd>{site.taxId}</dd></div>
        <div><dt>{copy.registration}</dt><dd>{site.registration}</dd></div>
        <div><dt>{copy.location}</dt><dd>{site.location}, Argentina</dd></div>
        <div><dt>{copy.contact}</dt><dd><a href={'mailto:' + site.email}>{site.email}</a></dd></div>
      </dl>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--paper);
    border-top: 0.45rem solid var(--blue);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 7vw, 7rem);
    align-items: end;
    padding-block: clamp(3rem, 6vw, 5.5rem);
  }

  .footer-inner h2 {
    margin: 1rem 0 0.65rem;
    font: 400 clamp(2.85rem, 6.2vw, 5.5rem) / 0.94 var(--serif);
  }

  .footer-inner h3 { margin-bottom: 0.75rem; }
  dl { margin: 0; }

  dl > div {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 0.25rem 1rem;
    padding-block: 0.75rem;
    border-top: 1px solid rgb(247 245 238 / 32%);
  }

  dt { color: var(--yellow); }
  dd { margin: 0; overflow-wrap: anywhere; }
  a:hover { color: var(--yellow); }

  @media (max-width: 49rem) {
    .footer-inner { grid-template-columns: 1fr; }
  }

  @media (max-width: 25rem) {
    dl > div { grid-template-columns: 1fr; }
  }
</style>
