---
import FoundationSections from './FoundationSections.astro';
import { foundation } from '../content/foundation';
import SiteLayout from '../layouts/SiteLayout.astro';
import { home, locales, routes, site, type Locale } from '../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = home[locale];
const sections = foundation[locale];
const nav = [
  ['#proposito', sections.purpose.label],
  ['#programas', sections.programs.label],
  ['#alianzas', sections.partnerships.label],
  ['#participar', sections.participation.label],
  ['#equipo', sections.team.label],
];
---

<SiteLayout locale={locale}>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="wordmark" href={routes[locale]}>{site.name}</a>
      <nav class="main-nav" aria-label={sections.navLabel}>
        {nav.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
      <nav class="language-nav" aria-label={copy.languageNavigation}>
        {locales.map((language) => (
          <a href={routes[language]} lang={home[language].language} hreflang={home[language].language}
            aria-label={language === 'es' ? 'Español' : 'English'}
            aria-current={language === locale ? 'page' : undefined}>
            {language.toUpperCase()}
          </a>
        ))}
      </nav>
    </div>
  </header>
  <main id="contenido" tabindex="-1">
    <section class="hero shell" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <p class="eyebrow">{copy.disciplines}</p>
        <h1 id="hero-heading">
          {copy.headline[0]}<br />
          {copy.headline[1]}<br />
          <em>{copy.headline[2]}</em>
        </h1>
        <p class="hero-lead">{copy.lead}</p>
        <div class="hero-actions">
          <a class="solid-link" href="#programas">{copy.programsLink} <span aria-hidden="true">↘</span></a>
          <a class="text-link" href="#participar">{copy.participateLink}</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="print-circle"></span>
        <span class="print-cutout"></span>
        <span class="print-square"></span>
      </div>
    </section>
    <FoundationSections locale={locale} />
  </main>
</SiteLayout>
